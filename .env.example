# ---------------------------------------------------------------
# Branding - the app is shown as "<COMPANY_NAME> DevPulse"
# ---------------------------------------------------------------
COMPANY_NAME=Acme

# ---------------------------------------------------------------
# Database - provide ONE of the two. If both are set, PostgreSQL wins.
# Tables / collections / indexes are created automatically on first start.
# ---------------------------------------------------------------
# PostgreSQL
POSTGRES_URL=
# e.g. postgres://devpulse:devpulse@localhost:5432/devpulse

# MongoDB (database name is taken from the URI path, default "devpulse")
MONGODB_URI=
# e.g. mongodb://localhost:27017/devpulse

# ---------------------------------------------------------------
# Data sources - configure GitHub, Bitbucket, or both.
# With both, stats are summed. With one, only that platform is used.
# ---------------------------------------------------------------
# GitHub: token needs read access to repositories + pull requests (fine-grained or classic "repo")
GITHUB_TOKEN=
GITHUB_ORGS=            # comma-separated organisations (or user accounts)
# GITHUB_REPOS=         # optional allow-list: "org/repo,other-repo"
# GITHUB_API_URL=https://api.github.com   # GitHub Enterprise: https://ghe.example.com/api/v3

# Bitbucket Cloud: use EITHER an access token OR username + app password / API token
BITBUCKET_WORKSPACES=   # comma-separated workspace slugs
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
# BITBUCKET_ACCESS_TOKEN=
# BITBUCKET_PROJECTS=  # optional project keys: "KEY" or "workspace/KEY" (workspace > project > repos)
# BITBUCKET_REPOS=      # optional allow-list inside that scope: "workspace/repo,other-repo"

# ---------------------------------------------------------------
# Sync
# ---------------------------------------------------------------
SYNC_INTERVAL_MINUTES=60    # 0 disables background sync (admin can still sync manually)
SYNC_LOOKBACK_DAYS=90       # how far back the very first sync reads
# AUTO_SEED=false           # empty DB: default is first real sync (if configured) or demo data (if not)

# ---------------------------------------------------------------
# Admin - the only account. There is no end-user login.
# ---------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=             # 16+ random characters, e.g. `openssl rand -hex 32`
# INSECURE_COOKIES=true     # only if you serve over plain http in production
