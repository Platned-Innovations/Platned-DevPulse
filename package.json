{
  "name": "devpulse",
  "version": "1.0.0",
  "private": true,
  "description": "Unified developer contribution leaderboard for GitHub and Bitbucket",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "serve": "npm run build && npm run start",
    "build:standalone": "node scripts/build-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
